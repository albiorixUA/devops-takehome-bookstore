# Local development environment template.
# Copy to .env and fill in values. .env is gitignored.
# Generate JWT_SECRET with: openssl rand -hex 32

NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://bookstore:bookstore_password@db:5432/bookstore
REDIS_URL=redis://redis:6379

# Required in production. Generate with: openssl rand -hex 32
JWT_SECRET=

# Server-side only. Never set NUXT_PUBLIC_* variants.
PAYMENT_TOKEN=
INTERNAL_API_TOKEN=

# Public (safe to ship to client bundle).
NUXT_PUBLIC_API_BASE=/api
